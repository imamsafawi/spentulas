<!-- Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
  :root {
    --primary: #1e3a8a;
    --secondary: #f59e0b;
    --accent: #3b82f6;
    --dark: #0f172a;
    --light: #f8fafc;
  }
  * { font-family: 'Poppins', sans-serif; }
  body { background: var(--light); color: var(--dark); margin: 0; padding: 0; }

  /* HERO */
  .hero {
    background: linear-gradient(135deg, rgba(30,58,138,0.92), rgba(59,130,246,0.85)),
                url('https://images.unsplash.com/photo-1580582932707-520aed937b7b?w=1600') center/cover;
    color: #fff; padding: 70px 0 60px; text-align: center;
  }
  .hero h1 { font-weight: 800; font-size: 2.6rem; margin-bottom: 10px; }
  .hero .motto {
    font-size: 1.3rem; font-weight: 600; color: var(--secondary);
    letter-spacing: 2px; margin-bottom: 20px; text-transform: uppercase;
  }
  .hero p.lead { font-size: 1.05rem; opacity: 0.95; max-width: 700px; margin: 0 auto; }
  .hero .badge-school {
    background: var(--secondary); color: var(--dark); padding: 6px 18px;
    border-radius: 50px; font-weight: 600; font-size: 0.85rem; display: inline-block; margin-bottom: 15px;
  }
  .hero-stats {
    display: flex; justify-content: center; gap: 30px; margin-top: 30px; flex-wrap: wrap;
  }
  .hero-stat {
    background: rgba(255,255,255,0.15); backdrop-filter: blur(10px);
    padding: 15px 25px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.2);
    min-width: 140px;
  }
  .hero-stat .num { font-size: 1.8rem; font-weight: 800; color: var(--secondary); }
  .hero-stat .label { font-size: 0.85rem; opacity: 0.9; }

  /* SECTION */
  .section-title { text-align: center; margin: 50px 0 30px; }
  .section-title h2 {
    font-weight: 700; color: var(--primary); position: relative; display: inline-block;
  }
  .section-title h2::after {
    content: ''; position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%);
    width: 60px; height: 4px; background: var(--secondary); border-radius: 2px;
  }
  .section-title p { color: #64748b; margin-top: 15px; }

  /* PROFIL KEPALA SEKOLAH */
  .profil-section { background: #fff; padding: 50px 0; }
  .kepsek-card {
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: #fff; border-radius: 16px; padding: 30px; text-align: center;
    box-shadow: 0 10px 30px rgba(30,58,138,0.2);
  }
  .kepsek-avatar {
    width: 120px; height: 120px; border-radius: 50%;
    background: #fff; color: var(--primary);
    display: flex; align-items: center; justify-content: center;
    font-size: 3rem; font-weight: 800; margin: 0 auto 15px;
    border: 4px solid var(--secondary);
  }
  .kepsek-card h4 { font-weight: 700; margin-bottom: 5px; }
  .kepsek-card .jabatan {
    background: var(--secondary); color: var(--dark); padding: 4px 14px;
    border-radius: 20px; font-size: 0.8rem; font-weight: 600;
    display: inline-block; margin-top: 8px;
  }
  .info-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 15px; margin-top: 20px;
  }
  .info-item {
    background: var(--light); border-radius: 12px; padding: 20px;
    border-left: 4px solid var(--secondary); transition: all 0.3s;
  }
  .info-item:hover { transform: translateY(-3px); box-shadow: 0 5px 15px rgba(0,0,0,0.08); }
  .info-item i { font-size: 1.8rem; color: var(--primary); margin-bottom: 8px; }
  .info-item .label { font-size: 0.8rem; color: #64748b; text-transform: uppercase; letter-spacing: 1px; }
  .info-item .value { font-size: 1rem; font-weight: 600; color: var(--dark); margin-top: 4px; }

  /* JAM OPERASIONAL */
  .jam-section { background: var(--light); padding: 50px 0; }
  .schedule-table {
    background: #fff; border-radius: 14px; overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  }
  .schedule-table table { margin: 0; }
  .schedule-table thead { background: var(--primary); color: #fff; }
  .schedule-table th { padding: 15px; font-weight: 600; border: none; }
  .schedule-table td { padding: 15px; vertical-align: middle; border-color: #e2e8f0; }
  .schedule-table tr.libur { background: #fef3c7; }
  .schedule-table tr.libur td { color: #92400e; font-weight: 500; }
  .status-badge {
    display: inline-block; padding: 4px 12px; border-radius: 20px;
    font-size: 0.75rem; font-weight: 600;
  }
  .status-active { background: #d1fae5; color: #065f46; }
  .status-libur { background: #fee2e2; color: #991b1b; }

  /* EKSTRAKURIKULER */
  .ekskul-section { background: #fff; padding: 50px 0; }
  .ekskul-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 15px; margin-top: 20px;
  }
  .ekskul-card {
    background: var(--light); border-radius: 12px; padding: 20px 15px;
    text-align: center; transition: all 0.3s; cursor: pointer;
    border: 2px solid transparent;
  }
  .ekskul-card:hover {
    background: #fff; border-color: var(--secondary);
    transform: translateY(-5px); box-shadow: 0 8px 20px rgba(245,158,11,0.2);
  }
  .ekskul-icon {
    width: 55px; height: 55px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: #fff; display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem; margin: 0 auto 10px;
  }
  .ekskul-card h6 { font-weight: 600; margin: 0; font-size: 0.9rem; color: var(--dark); }

  /* NEWS CARD */
  .news-card {
    background: #fff; border-radius: 14px; overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    transition: all 0.3s ease; margin-bottom: 20px;
    border: 1px solid rgba(0,0,0,0.04);
  }
  .news-card:hover { box-shadow: 0 8px 30px rgba(30,58,138,0.15); transform: translateY(-2px); }
  .news-img { width: 100%; height: 220px; object-fit: cover; }
  .news-body { padding: 20px; }
  .news-category {
    display: inline-block; background: var(--secondary); color: var(--dark);
    padding: 3px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 600;
    margin-bottom: 10px;
  }
  .news-title {
    font-weight: 700; color: var(--dark); font-size: 1.15rem; margin-bottom: 8px;
    cursor: pointer;
  }
  .news-title:hover { color: var(--primary); }
  .news-meta { font-size: 0.82rem; color: #64748b; margin-bottom: 12px; }
  .news-meta i { color: var(--accent); margin-right: 4px; }
  .news-summary { color: #475569; font-size: 0.92rem; line-height: 1.6; }

  .btn-toggle {
    background: var(--primary); color: #fff; border: none;
    padding: 8px 18px; border-radius: 8px; font-size: 0.85rem; font-weight: 500;
  }
  .btn-toggle:hover { background: #1e40af; color: #fff; }
  .btn-toggle i { transition: transform 0.3s; }
  .btn-toggle[aria-expanded="true"] i { transform: rotate(180deg); }

  .news-content {
    background: #f1f5f9; border-left: 4px solid var(--secondary);
    padding: 18px; border-radius: 8px; margin-top: 15px;
    color: #334155; line-height: 1.75; font-size: 0.93rem;
    white-space: pre-wrap;
  }

  .btn-share {
    background: transparent; color: var(--primary); border: 1.5px solid var(--primary);
    padding: 7px 16px; border-radius: 8px; font-size: 0.85rem; font-weight: 500;
  }
  .btn-share:hover { background: var(--primary); color: #fff; }

  /* LOKASI / MAPS */
  .lokasi-section { background: var(--light); padding: 50px 0; }
  .maps-wrapper {
    border-radius: 14px; overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }
  .maps-wrapper iframe { width: 100%; height: 400px; border: 0; display: block; }
  .alamat-card {
    background: #fff; border-radius: 14px; padding: 25px; height: 100%;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  }
  .alamat-card h5 { color: var(--primary); font-weight: 700; }
  .alamat-item {
    display: flex; gap: 12px; padding: 12px 0;
    border-bottom: 1px dashed #e2e8f0;
  }
  .alamat-item:last-child { border-bottom: none; }
  .alamat-item i {
    color: var(--secondary); font-size: 1.3rem; flex-shrink: 0; margin-top: 3px;
  }
  .alamat-item .label { font-size: 0.75rem; color: #64748b; text-transform: uppercase; }
  .alamat-item .value { font-weight: 600; color: var(--dark); }

  /* LOADING */
  .loader { text-align: center; padding: 60px 20px; }
  .spinner-custom {
    width: 50px; height: 50px; border: 4px solid #e2e8f0;
    border-top-color: var(--primary); border-radius: 50%;
    animation: spin 0.8s linear infinite; margin: 0 auto 15px;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* FOOTER */
  .site-footer {
    background: var(--dark); color: #cbd5e1; padding: 40px 0 20px; margin-top: 0;
  }
  .site-footer h5 { color: #fff; font-weight: 600; margin-bottom: 15px; }
  .site-footer a { color: #cbd5e1; text-decoration: none; }
  .site-footer a:hover { color: var(--secondary); }
  .footer-bottom {
    border-top: 1px solid #334155; padding-top: 20px; margin-top: 25px;
    text-align: center; font-size: 0.85rem;
  }
  .footer-motto {
    color: var(--secondary); font-weight: 700; letter-spacing: 2px;
    text-transform: uppercase; font-size: 0.9rem;
  }

  /* TOAST */
  .toast-custom {
    position: fixed; bottom: 20px; right: 20px;
    background: var(--primary); color: #fff; padding: 12px 22px;
    border-radius: 8px; box-shadow: 0 5px 20px rgba(0,0,0,0.2);
    z-index: 9999; opacity: 0; transform: translateY(20px);
    transition: all 0.3s;
  }
  .toast-custom.show { opacity: 1; transform: translateY(0); }

  @media (max-width: 768px) {
    .hero h1 { font-size: 1.8rem; }
    .hero .motto { font-size: 1rem; }
    .hero { padding: 50px 0 40px; }
    .hero-stats { gap: 15px; }
    .hero-stat { min-width: 110px; padding: 12px 18px; }
    .hero-stat .num { font-size: 1.4rem; }
    .ekskul-grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 10px; }
    .ekskul-card { padding: 15px 10px; }
    .maps-wrapper iframe { height: 300px; }
  }
</style>
</head>
