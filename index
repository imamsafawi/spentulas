<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
  // ====== GANTI URL INI ======
  const APPSCRIPT_URL = "https://script.google.com/a/macros/guru.smp.belajar.id/s/AKfycbxbkbdkzhFzlvisb7Djp_XgmogSl8VDqmoI2fPSWqrjxnN46KMVQ2lUo7ZEZPMhlAkPFA/exec";
  // ============================
  
  // Mode debug: tampilkan error detail di console & UI
  const DEBUG_MODE = true;

  const container = document.getElementById('newsContainer');
  const loader = document.getElementById('loader');

  // Data dummy untuk fallback (tampil jika Apps Script error)
  const DUMMY_DATA = [
    {
      id: 999,
      tanggal: "26 Okt 2026",
      judul: "Selamat Datang di Portal Berita SMPN 17 Surabaya",
      kategori: "Pengumuman",
      ringkasan: "Portal berita sekolah telah aktif. Berita terbaru akan ditampilkan di sini setelah Google Form dikonfigurasi dengan benar.",
      isi: "Ini adalah berita contoh (dummy) yang muncul karena sistem belum terhubung ke Google Apps Script.\n\nSilakan periksa:\n1. URL Apps Script sudah benar\n2. Deployment 'Anyone'\n3. Sheet 'Form Responses 1' ada dan berisi data\n4. Buka URL Apps Script di browser untuk melihat error",
      gambar: "https://via.placeholder.com/800x400/1e3a8a/ffffff?text=SMPN+17+Surabaya",
      penulis: "Admin"
    }
  ];

  async function loadBerita() {
    if (DEBUG_MODE) console.log('🔄 Memuat berita dari:', APPSCRIPT_URL);
    
    try {
      // Validasi URL
      if (!APPSCRIPT_URL || APPSCRIPT_URL.includes('XXXX')) {
        throw new Error('URL Apps Script belum diatur. Ganti APPSCRIPT_URL di script HTML.');
      }

      const res = await fetch(APPSCRIPT_URL, {
        method: 'GET',
        redirect: 'follow' // Penting: Apps Script melakukan redirect
      });
      
      if (!res.ok) {
        throw new Error(`HTTP ${res.status}: ${res.statusText}`);
      }
      
      const text = await res.text();
      if (DEBUG_MODE) console.log('📥 Response:', text.substring(0, 500));
      
      let json;
      try {
        json = JSON.parse(text);
      } catch (parseErr) {
        throw new Error('Response bukan JSON valid. Mungkin HTML error page. Response: ' + text.substring(0, 200));
      }

      if (json.status === 'error') {
        throw new Error('Apps Script error: ' + json.message);
      }

      if (!json.data || json.data.length === 0) {
        showEmpty();
        return;
      }

      renderBerita(json.data);
      
    } catch (err) {
      console.error('❌ Error:', err);
      if (DEBUG_MODE) {
        showError(err.message);
      } else {
        // Fallback ke data dummy
        renderBerita(DUMMY_DATA, true);
      }
    }
  }

  function renderBerita(data, isDummy = false) {
    container.innerHTML = '';
    
    if (isDummy) {
      const notice = document.createElement('div');
      notice.className = 'col-12';
      notice.innerHTML = `
        <div class="alert alert-warning" style="border-left:4px solid var(--secondary);">
          <i class="bi bi-exclamation-triangle-fill"></i> 
          <strong>Mode Demo:</strong> Menampilkan berita contoh karena gagal terhubung ke server.
          <button class="btn btn-sm btn-outline-dark ms-2" onclick="loadBerita()">
            <i class="bi bi-arrow-clockwise"></i> Coba Lagi
          </button>
        </div>
      `;
      container.appendChild(notice);
    }
    
    data.forEach((item) => {
      const collapseId = `collapse${item.id}`;
      const card = document.createElement('div');
      card.className = 'col-12';
      card.innerHTML = `
        <article class="news-card">
          <div class="row g-0">
            <div class="col-md-4">
              <img src="${escapeHtml(item.gambar)}" alt="${escapeHtml(item.judul)}"
                   class="news-img" onerror="this.src='https://via.placeholder.com/800x400/1e3a8a/ffffff?text=SMPN+17+Surabaya'">
            </div>
            <div class="col-md-8">
              <div class="news-body">
                <span class="news-category">${escapeHtml(item.kategori)}</span>
                <h3 class="news-title" data-bs-toggle="collapse" data-bs-target="#${collapseId}">
                  ${escapeHtml(item.judul)}
                </h3>
                <div class="news-meta">
                  <i class="bi bi-calendar3"></i> ${escapeHtml(item.tanggal)}
                  &nbsp;•&nbsp;
                  <i class="bi bi-person"></i> ${escapeHtml(item.penulis)}
                </div>
                <p class="news-summary mb-3">${escapeHtml(item.ringkasan)}</p>
                <div class="d-flex gap-2 flex-wrap">
                  <button class="btn-toggle" type="button"
                          data-bs-toggle="collapse" data-bs-target="#${collapseId}"
                          aria-expanded="false">
                    <i class="bi bi-chevron-down"></i> Baca Selengkapnya
                  </button>
                  <button class="btn-share" onclick="shareBerita(${item.id}, '${escapeAttr(item.judul)}')">
                    <i class="bi bi-share"></i> Bagikan
                  </button>
                </div>
                <div class="collapse" id="${collapseId}">
                  <div class="news-content mt-3">${escapeHtml(item.isi)}</div>
                </div>
              </div>
            </div>
          </div>
        </article>
      `;
      container.appendChild(card);
    });
  }

  function showEmpty() {
    container.innerHTML = `
      <div class="col-12 text-center py-5">
        <i class="bi bi-inbox" style="font-size:4rem;color:#cbd5e1;"></i>
        <p class="text-muted mt-3">Belum ada berita dipublikasikan.</p>
        <small class="text-muted">Silakan isi Google Form untuk menambah berita baru.</small>
      </div>`;
  }

  function showError(msg) {
    container.innerHTML = `
      <div class="col-12">
        <div class="alert alert-danger">
          <h5><i class="bi bi-exclamation-triangle-fill"></i> Gagal Memuat Berita</h5>
          <p class="mb-2"><strong>Error:</strong> ${escapeHtml(msg)}</p>
          <hr>
          <small>
            <strong>Cek:</strong><br>
            1. URL Apps Script sudah diganti (bukan XXXX...)<br>
            2. Apps Script di-deploy sebagai "Anyone"<br>
            3. Sheet bernama "${SHEET_NAME || 'Form Responses 1'}" ada<br>
            4. Buka URL Apps Script di browser untuk lihat detail error<br>
            5. Tekan F12 → tab Console untuk debug
          </small>
          <div class="mt-3">
            <button class="btn btn-primary btn-sm" onclick="loadBerita()">
              <i class="bi bi-arrow-clockwise"></i> Coba Lagi
            </button>
            <button class="btn btn-outline-secondary btn-sm" onclick="loadDummy()">
              <i class="bi bi-eye"></i> Lihat Demo
            </button>
          </div>
        </div>
      </div>`;
  }

  function loadDummy() {
    renderBerita(DUMMY_DATA, true);
  }

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }
  function escapeAttr(str) {
    return String(str || '').replace(/'/g,"\\'").replace(/"/g,'&quot;');
  }

  function shareBerita(id, judul) {
    const url = `${window.location.origin}${window.location.pathname}#berita-${id}`;
    const text = `Berita: ${judul} — SMP Negeri 17 Surabaya`;
    if (navigator.share) {
      navigator.share({ title: judul, text: text, url: url }).catch(() => copyToClipboard(url));
    } else {
      copyToClipboard(url);
    }
  }

  function copyToClipboard(text) {
    navigator.clipboard.writeText(text).then(() => showToast('Link berita berhasil disalin!'))
      .catch(() => {
        const ta = document.createElement('textarea');
        ta.value = text; document.body.appendChild(ta);
        ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
        showToast('Link berita berhasil disalin!');
      });
  }

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2500);
  }

  document.addEventListener('DOMContentLoaded', loadBerita);
</script>
